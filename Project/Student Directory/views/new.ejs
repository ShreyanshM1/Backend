<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Students</title>
</head>
<body>
  <form method="post" action="/students">
    <h3>Name: <input type="text" name="name" placeholder="Enter your name" required></h3>
    <h3>Branch: <input type="text" name="branch" placeholder="Enter your branch" required></h3>
    <h3>Year: <input type="number" name="year" placeholder="Enter your year" required></h3>
    <h3>Email: <input type="email" name="email" placeholder="Enter your email" required></h3>
    <button>Submit</button>
  </form>
  <a href="/students">
    <button type="button">Back to Students</button>
  </a>
</body>
</html>